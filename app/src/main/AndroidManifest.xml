<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@drawable/kotoba_icon"
        android:label="Kotoba Grammar"
        android:name=".KotobaGrammarApplication"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalKeyboard">
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.GrammarActivity" android:exported="false" />
        <activity android:name=".ui.KeyboardBuilderActivity" android:exported="false" />
        <activity android:name=".ui.TutorialActivity" android:exported="false" />
        <service
            android:name=".input.LocalKeyboardService"
            android:exported="true"
            android:label="Kotoba Grammar keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
