<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KOTOBA · DAILY"
        android:textColor="#FFEFE6FF"
        android:textSize="10sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="日"
        android:textColor="#FFFFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_translation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="sun · day"
        android:textColor="#FFF8F5FF"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/widget_explanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="A kanji meaning sun or day."
        android:textColor="#FFEFE6FF"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/widget_pronunciation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="nichi · hi"
        android:textColor="#FFEFE6FF"
        android:textSize="12sp" />
</LinearLayout>
